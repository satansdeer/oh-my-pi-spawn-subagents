{
  "name": "oh-my-pi-spawn-subagents",
  "version": "0.1.0",
  "description": "Pi package that adds real spawned subagents for oh-my-pi using the existing .oh-my-pi.jsonc config.",
  "license": "MIT",
  "author": "Maksim Ivanov <satansdeer@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "oh-my-pi",
    "subagents",
    "openrouter"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
